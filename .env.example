# Copy to frontend/.env.local if you need to override defaults. Never put secrets here:
# every VITE_* variable is embedded in the public JavaScript bundle.

# Absolute origin of the API when it is NOT served from the same origin as the web app,
# e.g. https://api.example.com. Leave empty to use same-origin /api/v1 (dev proxy).
VITE_API_BASE_URL=

# Dev/preview server only (not bundled): where the Vite proxy forwards /api requests.
API_PROXY_TARGET=http://localhost:4000

# Dev server only (not bundled): port for `npm run dev`. If you change it, add the new
# origin (e.g. http://localhost:5180) to CLIENT_ORIGINS in backend/.env.
WEB_PORT=5173
